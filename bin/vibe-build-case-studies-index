#!/usr/bin/env python3
# SPDX-License-Identifier: ISC
"""Index the case-study articles chronologically (E8.4 / vibe-61).

Reads `<corpus>/manifest.json`, follows its `articles` list, and emits
`<out>/data/case-studies.json` plus `<out>/case-studies/index.md` — newest first, so the index
opens on the most recent study. Per D-C an absent corpus is the honest pre-migration state:
exit 0 with zero entries and a "no audit data yet" notice. Only a corpus whose manifest cannot
be parsed is an error, and it renders nothing at all.

An article carries `--- title / date / repo ---` front matter. Where a field is missing the
filename supplies it (`2026-01-repo-alpha.md` dates and names itself), because an article that
forgot its front matter should still be listed rather than silently dropped.

    bin/vibe-build-case-studies-index --corpus <dir> --out <dir>
"""

import argparse
import json
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "scripts"))

from site_markdown import md_escape  # noqa: E402  (corpus strings render as text — vibe-196)

BUILDER = "vibe-build-case-studies-index"
SLUG = "case-studies"
PAGE = "case-studies/index.md"
NOTICE = "no audit data yet"

#: a leading `2026-01-14` or `2026-01` in the filename, used when front matter omits the date.
FILENAME_DATE = re.compile(r"^(\d{4}-\d{2}(?:-\d{2})?)[-_]?(.*)$")


def fail(message):
    """Report a named input defect on stderr and exit non-zero without rendering."""
    sys.stderr.write(f"{BUILDER}: {message}\n")
    raise SystemExit(2)


def load_manifest(corpus):
    """Parse the corpus manifest, or return None when the corpus does not exist yet."""
    manifest = corpus / "manifest.json"
    if not corpus.is_dir() or not manifest.is_file():
        return None
    try:
        parsed = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        fail(f"unparseable manifest at {manifest}: {exc}")
    if not isinstance(parsed, dict):
        fail(f"manifest at {manifest} is not a JSON object")
    return parsed


def split_front_matter(text):
    """Return (front-matter mapping, body) for a `---` fenced header, or ({}, text)."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}, text
    try:
        end = lines.index("---", 1)
    except ValueError:
        return {}, text
    fields = {}
    for line in lines[1:end]:
        key, sep, value = line.partition(":")
        if sep and key.strip():
            fields[key.strip().lower()] = value.strip().strip("'\"")
    return fields, "\n".join(lines[end + 1:])


def summarise(body):
    for line in body.splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("#"):
            return stripped
    return ""


def read_article(corpus, rel):
    """Turn one article into an index entry: title, date, repo, and a one-line summary."""
    path = corpus / rel
    if not path.is_file():
        sys.stderr.write(f"{BUILDER}: skipping article named by the manifest but absent: {rel}\n")
        return None
    fields, body = split_front_matter(path.read_text(encoding="utf-8"))
    stem = Path(rel).stem
    match = FILENAME_DATE.match(stem)
    date = str(fields.get("date") or (match.group(1) if match else "")).strip()
    fallback = (match.group(2) if match else stem).replace("-", " ").strip()
    return {"title": fields.get("title") or fallback.capitalize() or stem,
            "date": date, "repo": fields.get("repo", ""), "source": rel,
            "slug": stem, "summary": summarise(body)}


def collect(corpus, manifest):
    articles = manifest.get("articles") if isinstance(manifest.get("articles"), list) else []
    entries = [read_article(corpus, rel) for rel in articles if isinstance(rel, str)]
    entries = [entry for entry in entries if entry]
    return sorted(entries, key=lambda entry: (entry["date"], entry["title"]), reverse=True)


def render(entries):
    if not entries:
        return ("# Case studies\n\n"
                f"_{NOTICE}._ No case study has been published here yet; each study is listed "
                "the moment its article lands.\n")
    lines = ["# Case studies", "",
             f"{len(entries)} study(ies), most recent first.", ""]
    for entry in entries:
        head = f"- **{md_escape(entry['title'])}**"
        if entry["date"]:
            head += f" — {md_escape(entry['date'])}"
        if entry["repo"]:
            head += f" ({md_escape(entry['repo'])})"   # plain text, not a code span (see md_escape)
        lines.append(head)
        if entry["summary"]:
            lines.append(f"  {md_escape(entry['summary'])}")
    return "\n".join(lines) + "\n"


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def main(argv=None):
    parser = argparse.ArgumentParser(prog=BUILDER, description=__doc__.splitlines()[0])
    parser.add_argument("--corpus", required=True, type=Path, help="corpus root directory")
    parser.add_argument("--out", required=True, type=Path, help="site output directory")
    args = parser.parse_args(argv)

    manifest = load_manifest(args.corpus)
    entries = [] if manifest is None else collect(args.corpus, manifest)

    payload = {"builder": BUILDER, "count": len(entries), "order": "date-descending",
               "entries": entries}
    write(args.out / "data" / f"{SLUG}.json", json.dumps(payload, indent=2) + "\n")
    write(args.out / PAGE, render(entries))
    return 0


if __name__ == "__main__":
    sys.exit(main())
