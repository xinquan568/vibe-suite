#!/usr/bin/env python3
# SPDX-License-Identifier: ISC
"""Render the framework reference into the site's docs section (E8.4 / vibe-61).

Reads `<corpus>/manifest.json`, follows its `docs` list, and emits `<out>/data/docs.json` plus
`<out>/docs/index.md` and a contents page per document. Per D-C an absent corpus is the honest
pre-migration state: exit 0 with zero entries and a "no audit data yet" notice. Only a corpus
whose manifest cannot be parsed is an error, and it renders nothing at all.

Both source shapes the framework reference is published in are read — Markdown headings and
rendered HTML — because the corpus is mid-migration and a builder that understood only one of
them would report an empty docs section as if the pages did not exist.

    bin/vibe-build-docs --corpus <dir> --out <dir>
"""

import argparse
import html
import json
import re
import sys
from pathlib import Path

BUILDER = "vibe-build-docs"
SLUG = "docs"
PAGE = "docs/index.md"
NOTICE = "no audit data yet"

HTML_SUFFIXES = (".html", ".htm", ".xhtml")
TAG = re.compile(r"<[^>]+>")
HEADING_TAG = re.compile(r"<h(?P<level>[12])\b[^>]*>(?P<text>.*?)</h(?P=level)>",
                         re.IGNORECASE | re.DOTALL)


def fail(message):
    """Report a named input defect on stderr and exit non-zero without rendering."""
    sys.stderr.write(f"{BUILDER}: {message}\n")
    raise SystemExit(2)


def load_manifest(corpus):
    """Parse the corpus manifest, or return None when the corpus does not exist yet."""
    manifest = corpus / "manifest.json"
    if not corpus.is_dir() or not manifest.is_file():
        return None
    try:
        parsed = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        fail(f"unparseable manifest at {manifest}: {exc}")
    if not isinstance(parsed, dict):
        fail(f"manifest at {manifest} is not a JSON object")
    return parsed


def slugify(text):
    return re.sub(r"[^a-z0-9]+", "-", str(text).lower()).strip("-") or "doc"


def plain(fragment):
    return html.unescape(TAG.sub(" ", fragment)).strip()


def outline_html(text):
    """Return (title, sections, summary) for a rendered HTML document."""
    title, sections = "", []
    for match in HEADING_TAG.finditer(text):
        heading = plain(match.group("text"))
        if match.group("level") == "1" and not title:
            title = heading
        elif match.group("level") == "2" and heading:
            sections.append(heading)
    body = HEADING_TAG.sub(" ", text)
    paragraphs = (plain(chunk) for chunk in re.split(r"(?i)</?p\b[^>]*>", body))
    return title, sections, next((p for p in paragraphs if p), "")


def outline_markdown(text):
    """Return (title, sections, summary) for a Markdown document."""
    title, sections, summary = "", [], ""
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("## "):
            sections.append(stripped[3:].strip())
        elif stripped.startswith("# ") and not title:
            title = stripped[2:].strip()
        elif stripped and not stripped.startswith("#") and not summary:
            summary = stripped
    return title, sections, summary


def read_doc(corpus, rel):
    """Turn one reference document into an entry: its title, outline, and lead paragraph."""
    path = corpus / rel
    if not path.is_file():
        sys.stderr.write(f"{BUILDER}: skipping doc named by the manifest but absent: {rel}\n")
        return None
    text = path.read_text(encoding="utf-8", errors="replace")
    is_html = path.suffix.lower() in HTML_SUFFIXES
    title, sections, summary = (outline_html if is_html else outline_markdown)(text)
    title = title or Path(rel).stem.replace("-", " ").capitalize()
    return {"title": title, "slug": slugify(title), "source": rel,
            "format": "html" if is_html else "markdown",
            "sections": sections, "summary": summary}


def collect(corpus, manifest):
    docs = manifest.get("docs") if isinstance(manifest.get("docs"), list) else []
    entries = [read_doc(corpus, rel) for rel in docs if isinstance(rel, str)]
    return [entry for entry in entries if entry]


def render_index(entries):
    if not entries:
        return ("# Documentation\n\n"
                f"_{NOTICE}._ The framework reference has not been migrated here yet; each "
                "document is listed as soon as it lands.\n")
    lines = ["# Documentation", "", f"{len(entries)} document(s) in the framework reference.", ""]
    for entry in entries:
        lines.append(f"- [{entry['title']}]({entry['slug']}.md)"
                     + (f" — {entry['summary']}" if entry["summary"] else ""))
    return "\n".join(lines) + "\n"


def render_doc(entry):
    lines = [f"# {entry['title']}", ""]
    if entry["summary"]:
        lines += [entry["summary"], ""]
    if entry["sections"]:
        lines += ["## Contents", ""] + [f"- {name}" for name in entry["sections"]] + [""]
    lines.append(f"Source: `{entry['source']}` ({entry['format']}).")
    return "\n".join(lines) + "\n"


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def main(argv=None):
    parser = argparse.ArgumentParser(prog=BUILDER, description=__doc__.splitlines()[0])
    parser.add_argument("--corpus", required=True, type=Path, help="corpus root directory")
    parser.add_argument("--out", required=True, type=Path, help="site output directory")
    args = parser.parse_args(argv)

    manifest = load_manifest(args.corpus)
    entries = [] if manifest is None else collect(args.corpus, manifest)

    payload = {"builder": BUILDER, "count": len(entries), "entries": entries}
    write(args.out / "data" / f"{SLUG}.json", json.dumps(payload, indent=2) + "\n")
    write(args.out / PAGE, render_index(entries))
    for entry in entries:
        write(args.out / "docs" / f"{entry['slug']}.md", render_doc(entry))
    return 0


if __name__ == "__main__":
    sys.exit(main())
