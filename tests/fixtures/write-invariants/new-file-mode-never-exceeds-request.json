{
  "schema": 1,
  "id": "new-file-mode-never-exceeds-request",
  "invariant": "A new file's permission bits are a subset of the requested bits under any umask.",
  "setup": [],
  "operation": {
    "name": "write_atomic",
    "dest": "n.json",
    "content": "new",
    "mode": "0644"
  },
  "expect": {
    "outcome": "written",
    "content": "new",
    "mode": {
      "subset_of": "0644"
    },
    "entries": [
      "n.json"
    ]
  },
  "umask": "0077"
}
