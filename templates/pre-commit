#!/bin/sh
# SPDX-License-Identifier: ISC
# vibe-suite pre-commit hook: refuse the commit when bin/vibe-check reports findings.
# Install:  cp templates/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# The root is passed explicitly — the hook never relies on incidental CWD.
root="$(git rev-parse --show-toplevel)" || exit 2
exec python3 "$root/bin/vibe-check" "$root"
